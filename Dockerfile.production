FROM ubuntu:24.04 AS build
ARG FLUTTER_VERSION=3.50.0
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils zip libglu1-mesa && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${FLUTTER_VERSION} https://github.com/flutter/flutter.git /opt/flutter
ENV PATH=/opt/flutter/bin:$PATH
RUN flutter config --no-analytics && flutter precache --web
WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get
COPY . .
ARG API_BASE_URL=
ARG GOOGLE_WEB_CLIENT_ID=
ARG GOOGLE_SERVER_CLIENT_ID=
RUN test -n "$GOOGLE_WEB_CLIENT_ID" || (echo "GOOGLE_WEB_CLIENT_ID must be supplied to preserve Google sign-in" >&2; exit 1)
RUN flutter build web --release --no-pub --dart-define=API_BASE_URL=${API_BASE_URL} --dart-define=GOOGLE_WEB_CLIENT_ID=${GOOGLE_WEB_CLIENT_ID} --dart-define=GOOGLE_SERVER_CLIENT_ID=${GOOGLE_SERVER_CLIENT_ID}

FROM nginx:1.28-alpine AS runtime
COPY nginx.production.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
